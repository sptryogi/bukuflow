# ---- Database (Neon, pakai connection string "pooled") ----
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- Akun admin (dibuat otomatis saat login pertama, lalu bisa diganti di menu profil) ----
ADMIN_EMAIL=admin
ADMIN_PASSWORD=DRPersada01

# ---- Keamanan sesi: string acak >= 32 karakter ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# ---- Alamat aplikasi (dipakai di link konfirmasi email) ----
APP_URL=http://localhost:3000

# ---- Email konfirmasi: pilih salah satu penyedia ----
# Opsi A: Brevo (gratis, cukup verifikasi satu alamat pengirim)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Opsi B: Resend (butuh domain terverifikasi agar bisa kirim ke semua orang)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# Pengirim, format: Nama <alamat@domain>
EMAIL_FROM=NusaLiterasi <noreply@contoh.com>
